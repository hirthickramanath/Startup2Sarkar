# ── Startup2Sarkar configuration ──────────────────────────────────────────────
# Copy to .env for local use, or set these in your host's dashboard. NEVER commit real values.

NODE_ENV=production
PORT=3001

# ── Required in production (the server refuses to start without them) ──
# Generate each with:  openssl rand -hex 32
JWT_SECRET=
COOKIE_SECRET=
FIELD_ENCRYPTION_KEY=

# ── Database ──
# Postgres connection string (Supabase "Session pooler", Render Postgres, Neon, RDS...). REQUIRED in production.
DATABASE_URL=
# Demo-only escape hatch: use the embedded PGlite file database in production. Needs a persistent disk, one instance only.
# ALLOW_EMBEDDED_DB=true
# TLS is on automatically for non-local hosts. Set to "false" only for a trusted private network.
# DATABASE_SSL=true

# ── First administrator (created once, only if no admin exists) ──
ADMIN_EMAIL=
# Optional. If empty a strong random password is generated and printed ONCE in the server log.
ADMIN_PASSWORD=
ADMIN_NAME=Platform Administrator

# ── Google sign-in (optional) ──
# OAuth 2.0 Client ID (Web application). The browser needs it, so it is not a secret.
# In Google Cloud Console add your site's URL under "Authorized JavaScript origins".
GOOGLE_CLIENT_ID=

# ── Human check on sign-up and password reset (optional): Cloudflare Turnstile ──
# Create a free Turnstile widget in the Cloudflare dashboard and add your site's domain. The site key is public; the secret stays on the server.
# When the secret is set, sign-up, onboarding, registration and "forgot password" refuse requests without a valid token (fails closed).
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ── Persistent document storage (optional): Supabase Storage ──
# Create a PRIVATE bucket (e.g. "documents") in Supabase, then paste the project URL and a SECRET key (sb_secret_..., from Settings > API Keys > "Publishable and secret API keys").
# The older JWT-style service_role key also works. Either one is a master key: server only, never in the browser.
# Without these, documents are stored on local disk under UPLOAD_DIR, which is lost on redeploy unless it is a mounted volume.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
# SUPABASE_BUCKET=documents

# ── Two-step verification for staff ──
# Mandatory in production for government, finance, inspector and admin accounts. Override with REQUIRE_STAFF_MFA=false (not recommended).
# REQUIRE_STAFF_MFA=true
# Staff can postpone the enrolment screen with "Skip for now" this many times (24 hours each) before it is required
# MFA_MAX_SKIPS=5

# ── Email (optional): forgot-password and decision emails, sent through Brevo ──
# Needs a Brevo account and a sender address you have verified there. A custom domain with SPF/DKIM keeps mail out of spam.
# Without these the "Forgot password?" link is hidden and messages are only recorded in memory (development).
BREVO_API_KEY=
EMAIL_FROM=
# EMAIL_FROM_NAME=Startup2Sarkar

# ── GitHub sign-in (optional, startups only) ──
# Create an OAuth App: GitHub > Settings > Developer settings > OAuth Apps > New OAuth App.
# Authorization callback URL:  https://<your-site>/api/v1/auth/github/callback
# The secret stays on the server. Only the profile and verified email are read; tokens are never stored.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Public address of the site (used to build the callback URL). Set it behind a proxy or custom domain.
# PUBLIC_URL=https://your-site.example

# ── AI (optional) ──
# Without a key the assistant, challenge drafting and proposal scoring use the built-in rules engine.
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.1-flash-lite
# NOTE: Google may use prompts sent on the FREE Gemini quota to improve its products. Use paid quota for real data.
# The model gets NO tools (no web search / URL access) and only role-scoped records + the market snapshot below.

# ── Market snapshot for the assistant (fetched by the server from one fixed host) ──
# ECB daily reference rates (USD/EUR/GBP vs INR) via api.frankfurter.dev. Not live quotes. Set to "off" to disable.
# MARKET_DATA=on

# ── Hosting ──
# Extra browser origins allowed to call the API (comma-separated). Same-origin needs nothing.
# CORS_ORIGIN=https://your-domain.example
# Set when behind a reverse proxy/load balancer (default: on in production).
# TRUST_PROXY=true
# Where uploaded evidence files are stored. Point at a persistent disk/volume.
# UPLOAD_DIR=/data/uploads
# Expose the Swagger UI at /docs in production (default: off).
# ENABLE_DOCS=false
